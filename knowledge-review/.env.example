LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 生成预算：按实际服务与模型的可靠容量设置；以下只是应用保守值示例。
# 未设置容量时程序标注为未经服务核实的 fallback；不会使用 embedding tokenizer。
# LLM_CONTEXT_TOKENS=32768
# LLM_OUTPUT_TOKENS=4096
# LLM_SAFETY_TOKENS=2048

# PDF 基础解析不需要模型。Docling 需另装依赖并事先准备本地模型。
# PDF_PARSER=pymupdf
# DOCLING_ARTIFACTS_PATH=E:/your-local-docling-models
# PDF_DO_OCR=0
# 视觉请求默认使用上面的聊天模型；以下各项可独立覆盖，留空则复用 LLM_*。
# 不按模型名猜图片能力；服务明确拒绝图片时保留常规解析，避免重复请求。
# VLM_MODEL=your_vision_model
# VLM_API_KEY=your_vision_api_key
# VLM_BASE_URL=https://your-provider.example/v1
# 设为 1 后，导入时最多对 3 个异常页调用 VLM；失败保留部分结果。
# PDF_VLM_ENABLED=0
